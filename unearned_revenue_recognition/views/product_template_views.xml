<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_unearned_revenue" model="ir.ui.view">
        <field name="name">product.template.form.inherit.unearned.revenue</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="inside">
                <field name="x_revenue_recognition_method"/>
            </xpath>
        </field>
    </record>

</odoo>
