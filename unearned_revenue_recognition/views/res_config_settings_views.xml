<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_unearned_revenue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.unearned.revenue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="unearned_revenue_setting"
                         string="Unearned Revenue Recognition"
                         help="Default Unearned Revenue (liability) account and Miscellaneous journal used to defer revenue recognition until physical delivery.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="x_default_unearned_revenue_account_id"
                                   string="Default Unearned Revenue Account"
                                   class="col-lg-5 o_light_label"/>
                            <field name="x_default_unearned_revenue_account_id"
                                   options="{'no_create_edit': True}"/>
                        </div>
                        <div class="row mt8">
                            <label for="x_recognition_journal_id"
                                   string="Recognition Journal"
                                   class="col-lg-5 o_light_label"/>
                            <field name="x_recognition_journal_id"
                                   options="{'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
