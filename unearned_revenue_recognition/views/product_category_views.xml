<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_view_inherit_unearned_revenue" model="ir.ui.view">
        <field name="name">product.category.form.inherit.unearned.revenue</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Unearned Revenue" groups="account.group_account_invoice">
                    <field name="x_unearned_revenue_account_id"
                           options="{'no_create_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
